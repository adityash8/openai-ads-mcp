# Copy to .env and fill in. NEVER commit the real .env.
# Any key you paste into a chat or log should be considered compromised — rotate it.

# Which account key the server uses when a tool call omits account_key.
# This is just a label you choose (uppercase, env-safe). Default: PRIMARY.
OPENAI_ADS_DEFAULT_ACCOUNT="PRIMARY"

# The OpenAI Ads API key for that account. The env var name is
# OPENAI_ADS_<ACCOUNT>_API_KEY — so the PRIMARY account reads this one.
# Requires OpenAI Ads API access (see README — not publicly available yet).
OPENAI_ADS_PRIMARY_API_KEY=""

# Add one per additional account, e.g.:
# OPENAI_ADS_BRANDX_API_KEY=""

# Live mutations are OFF by default. Set to 1 AND supply an approval artifact
# (tasks/openai-ads/approvals/<id>.json) to allow writes. See README.
OPENAI_ADS_ENABLE_WRITES="0"

# Optional overrides
# OPENAI_ADS_BASE_URL="https://api.ads.openai.com/v1"
# OPENAI_ADS_REPO_ROOT="."
# OPENAI_ADS_APPROVAL_DIR="tasks/openai-ads/approvals"
# OPENAI_ADS_AUDIT_LOG="tasks/openai-ads/audit.jsonl"
